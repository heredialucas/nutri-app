generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// AUTH INFRASTRUCTURE
// ──────────────────────────────────────────────

model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  password  String
  fullName  String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  firstName String?
  lastName  String?
  username  String?    @unique
  userRoles UserRole[]
  passwordResetTokens PasswordResetToken[]

  // WhatsApp settings
  whatsappSetting WhatsAppSetting?

  // Patient portal
  patient Patient?
  anamnesisCreatedBy PatientAnamnesis[] @relation("AnamnesisCreatedBy")

  // Nutrition relations
  professionalAppointments Appointment[]               @relation("ProfessionalAppointments")
  professionalAvailability Availability[]
  uploadedPatientFiles     PatientFile[]               @relation("UploadedPatientFiles")
  uploadedProgressPhotos   ProgressPhoto[]             @relation("UploadedProgressPhotos")
  measurementsTaken        AnthropometricMeasurement[] @relation("MeasurementsTaken")
  measuredIsakAssessments  IsakAssessment[]            @relation("MeasuredIsakAssessments")
  publishedIsakAssessments IsakAssessment[]            @relation("PublishedIsakAssessments")
  createdPlans             NutritionPlan[]             @relation("CreatedPlans")
  createdRecipes           Recipe[]                    @relation("CreatedRecipes")

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ──────────────────────────────────────────────
// PATIENTS
// ──────────────────────────────────────────────

model Patient {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String?   @unique @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  birthDate        DateTime?
  gender           String?
  documentNumber   String?
  address          String?
  city             String?
  occupation       String?
  emergencyContact String?
  emergencyPhone   String?
  healthInsurance  String?
  billingType      String
  status           String    @default("ACTIVE")
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user            User?                       @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments    Appointment[]
  medicalHistory  MedicalHistory?
  allergies       Allergy[]
  medications     Medication[]
  goals           PatientGoal[]
  measurements    AnthropometricMeasurement[]
  isakAssessments IsakAssessment[]
  progressPhotos  ProgressPhoto[]
  nutritionPlans  NutritionPlanPatient[]
  followUps       FollowUp[]
  files           PatientFile[]
  consents        Consent[]
  payments        Payment[]
  waitlistEntries WaitlistEntry[]
  messageThreads  MessageThread[]
  anamnesis       PatientAnamnesis?

  @@map("patients")
}

model PatientAnamnesis {
  id String @id @default(uuid()) @db.Uuid
  patientId String @unique @db.Uuid
  consultationReason String?
  mainObjective String?
  mealsPerDay String?
  waterIntake String?
  breakfast String?
  lunch String?
  snack String?
  dinner String?
  snacksDrinks String?
  likedFoods String?
  dislikedFoods String?
  difficultFoods String?
  eatsOut Boolean?
  eatsOutFrequency String?
  physicalActivity Boolean?
  activityName String?
  activityDays String?
  activityDuration String?
  activitySchedule String?
  activityLevel String?
  sportsObjective String?
  sleepHours String?
  sleepQuality String?
  stressLevel String?
  energyLevel String?
  supplements String?
  digestiveSymptoms String?
  bowelFrequency String?
  digestiveNotes String?
  previousDiets Boolean?
  adherenceDifficulty String?
  readinessScore Int?
  treatmentGoal String?
  agreedGoal String?
  nextControl DateTime?
  anthropometryMethod String?
  visceralFat String?
  professionalNotes String?
  status String @default("DRAFT")
  completedBy String? @db.Uuid
  completedAt DateTime?
  reviewedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  createdBy User? @relation("AnamnesisCreatedBy", fields: [completedBy], references: [id], onDelete: SetNull)

  @@map("patient_anamneses")
}

// ──────────────────────────────────────────────
// MEDICAL HISTORY
// ──────────────────────────────────────────────

model MedicalHistory {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @unique @db.Uuid
  familyHistory     String?
  personalHistory   String?
  surgeries         String?
  diagnoses         String?
  habits            String?
  sleepHours        String?
  physicalActivity  String?
  digestiveSymptoms String?
  observations      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_histories")
}

model Allergy {
  id        String  @id @default(uuid()) @db.Uuid
  patientId String  @db.Uuid
  name      String
  reaction  String?
  severity  String?
  notes     String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

model Medication {
  id         String    @id @default(uuid()) @db.Uuid
  patientId  String    @db.Uuid
  name       String
  dosage     String?
  frequency  String?
  indication String?
  startDate  DateTime?
  endDate    DateTime?
  notes      String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medications")
}

model PatientGoal {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  type        String
  description String?
  targetValue String?
  targetDate  DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_goals")
}

// ──────────────────────────────────────────────
// APPOINTMENTS & AVAILABILITY
// ──────────────────────────────────────────────

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @db.Uuid
  professionalId     String            @db.Uuid
  type               AppointmentType
  status             AppointmentStatus @default(PENDING)
  startAt            DateTime
  endAt              DateTime
  location           String?
  meetingUrl         String?
  notes              String?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient      Patient @relation(fields: [patientId], references: [id])
  professional User    @relation("ProfessionalAppointments", fields: [professionalId], references: [id])

  @@map("appointments")
}

model Availability {
  id             String  @id @default(uuid()) @db.Uuid
  professionalId String  @db.Uuid
  weekday        Int
  startTime      String
  endTime        String
  slotDuration   Int     @default(30)
  isActive       Boolean @default(true)

  professional User @relation(fields: [professionalId], references: [id])

  @@map("availability")
}

// ──────────────────────────────────────────────
// MEASUREMENTS & PROGRESS
// ──────────────────────────────────────────────

model AnthropometricMeasurement {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @db.Uuid
  appointmentId     String?
  measuredById      String?  @db.Uuid
  measuredAt        DateTime @default(now())
  weight            Decimal? @db.Decimal(5, 2)
  height            Decimal? @db.Decimal(5, 2)
  bmi               Decimal? @db.Decimal(4, 2)
  waist             Decimal? @db.Decimal(5, 2)
  hip               Decimal? @db.Decimal(5, 2)
  arm               Decimal? @db.Decimal(5, 2)
  bodyFatPercentage Decimal? @db.Decimal(4, 2)
  muscleMass        Decimal? @db.Decimal(5, 2)
  notes             String?

  patient    Patient @relation(fields: [patientId], references: [id])
  measuredBy User?   @relation("MeasurementsTaken", fields: [measuredById], references: [id])

  @@map("anthropometric_measurements")
}

// ──────────────────────────────────────────────
// ISAK ANTHROPOMETRIC ASSESSMENT (composición corporal)
// ──────────────────────────────────────────────

model IsakAssessment {
  id            String   @id @default(uuid()) @db.Uuid
  patientId     String   @db.Uuid
  measuredById  String?  @db.Uuid
  appointmentId String?
  measuredAt    DateTime @default(now())

  activityLevel String?
  sport         String?

  weight Decimal? @db.Decimal(5, 2)
  height Decimal? @db.Decimal(5, 2)

  // Pliegues cutáneos (mm)
  tricepsSF    Decimal? @db.Decimal(5, 2)
  subscapSF    Decimal? @db.Decimal(5, 2)
  suprailiacSF Decimal? @db.Decimal(5, 2)
  abdominalSF  Decimal? @db.Decimal(5, 2)
  thighSF      Decimal? @db.Decimal(5, 2)
  calfSF       Decimal? @db.Decimal(5, 2)

  // Perímetros (cm)
  relaxedArm Decimal? @db.Decimal(5, 2)
  flexedArm  Decimal? @db.Decimal(5, 2)
  waist      Decimal? @db.Decimal(5, 2)
  hip        Decimal? @db.Decimal(5, 2)
  midThigh   Decimal? @db.Decimal(5, 2)
  calf       Decimal? @db.Decimal(5, 2)

  // Diámetros ISAK (mm)
  humerusBreadth   Decimal? @db.Decimal(6, 2)
  femurBreadth     Decimal? @db.Decimal(6, 2)
  biStyloidWrist   Decimal? @db.Decimal(6, 2)

  notes                String?
  publishedToPatientAt DateTime?
  publishedById        String?   @db.Uuid
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  patient     Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  measuredBy  User?   @relation("MeasuredIsakAssessments", fields: [measuredById], references: [id])
  publishedBy User?   @relation("PublishedIsakAssessments", fields: [publishedById], references: [id], onDelete: SetNull)

  @@map("isak_assessments")
}

model ProgressPhoto {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  uploadedById   String?   @db.Uuid
  url            String
  publicId       String
  type           String
  takenAt        DateTime?
  consentGranted Boolean   @default(false)
  createdAt      DateTime  @default(now())

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User?   @relation("UploadedProgressPhotos", fields: [uploadedById], references: [id])

  @@map("progress_photos")
}

// ──────────────────────────────────────────────
// NUTRITION PLANS
// ──────────────────────────────────────────────

model NutritionPlan {
  id             String    @id @default(uuid()) @db.Uuid
  professionalId String    @db.Uuid
  title          String
  description    String?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("DRAFT")
  calorieTarget  Int?
  proteinTarget  Int?
  carbTarget     Int?
  fatTarget      Int?
  notes          String?
  tips           String?
  pdfUrl         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional User                   @relation("CreatedPlans", fields: [professionalId], references: [id])
  patients     NutritionPlanPatient[]
  days         NutritionPlanDay[]
  recipes      Recipe[]
  supplements  PlanSupplement[]

  @@map("nutrition_plans")
}

model NutritionPlanPatient {
  planId     String   @db.Uuid
  patientId  String   @db.Uuid
  assignedAt DateTime @default(now())

  plan    NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([planId, patientId])
  @@map("nutrition_plan_patients")
}

model NutritionPlanDay {
  id       String @id @default(uuid()) @db.Uuid
  planId   String @db.Uuid
  dayOrder Int
  label    String

  plan  NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@map("nutrition_plan_days")
}

model Meal {
  id        String  @id @default(uuid()) @db.Uuid
  dayId     String  @db.Uuid
  label     String
  mealOrder Int
  notes     String?

  day   NutritionPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  foods MealFood[]

  @@map("meals")
}

model MealFood {
  id       String   @id @default(uuid()) @db.Uuid
  mealId   String   @db.Uuid
  name     String
  quantity String?
  unit     String?
  notes    String?
  calories Int?
  protein  Decimal? @db.Decimal(5, 2)
  carbs    Decimal? @db.Decimal(5, 2)
  fat      Decimal? @db.Decimal(5, 2)

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_foods")
}

model PlanSupplement {
  id              String  @id @default(uuid()) @db.Uuid
  nutritionPlanId String  @db.Uuid
  name            String
  dosage          String?
  timing          String?
  frequency       String?
  notes           String?

  nutritionPlan NutritionPlan @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)

  @@map("plan_supplements")
}

// ──────────────────────────────────────────────
// RECIPES & SHOPPING LISTS
// ──────────────────────────────────────────────

model Recipe {
  id              String   @id @default(uuid()) @db.Uuid
  professionalId  String   @db.Uuid
  nutritionPlanId String?  @db.Uuid
  title           String
  description     String?
  ingredients     String?
  instructions    String?
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional  User           @relation("CreatedRecipes", fields: [professionalId], references: [id])
  nutritionPlan NutritionPlan? @relation(fields: [nutritionPlanId], references: [id], onDelete: SetNull)

  @@map("recipes")
}

model ShoppingList {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String?
  nutritionPlanId String?
  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id        String  @id @default(uuid()) @db.Uuid
  listId    String  @db.Uuid
  name      String
  quantity  String?
  unit      String?
  isChecked Boolean @default(false)

  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("shopping_list_items")
}

// ──────────────────────────────────────────────
// FOLLOW-UPS
// ──────────────────────────────────────────────

model FollowUp {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @db.Uuid
  weekStart    DateTime
  weight       Decimal? @db.Decimal(5, 2)
  adherence    String?
  hunger       String?
  energy       String?
  difficulties String?
  patientNotes String?
  proNotes     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("follow_ups")
}

// ──────────────────────────────────────────────
// FILES & CONSENTS
// ──────────────────────────────────────────────

model PatientFile {
  id           String   @id @default(uuid()) @db.Uuid
  patientId    String   @db.Uuid
  uploadedById String?  @db.Uuid
  name         String
  url          String
  publicId     String?
  mimeType     String?
  size         Int?
  category     String?
  createdAt    DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User?   @relation("UploadedPatientFiles", fields: [uploadedById], references: [id])

  @@map("patient_files")
}

model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  type        String
  version     String?
  signedAt    DateTime @default(now())
  signature   String?
  ipAddress   String?
  documentUrl String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("consents")
}

// ──────────────────────────────────────────────
// FINANCES
// ──────────────────────────────────────────────

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  method      String
  description String?
  date        DateTime @default(now())
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  notes       String?

  @@map("expenses")
}

// ──────────────────────────────────────────────
// WAITLIST & MESSAGES
// ──────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("waitlist_entries")
}

model MessageThread {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  createdAt DateTime @default(now())

  patient  Patient   @relation(fields: [patientId], references: [id])
  messages Message[]

  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ──────────────────────────────────────────────
// WHATSAPP & NOTIFICATIONS
// ──────────────────────────────────────────────

model WhatsAppSetting {
  id              String  @id @default(uuid()) @db.Uuid
  userId          String  @unique @map("user_id") @db.Uuid
  encryptedPhone  String  @map("encrypted_phone") @db.Text
  encryptedApiKey String  @map("encrypted_api_key") @db.Text
  enabled         Boolean @default(true)

  // Recordatorios para el profesional
  notifTurnosHoy              Boolean @default(true) @map("notif_turnos_hoy")
  notifTurnosManana           Boolean @default(true) @map("notif_turnos_manana")
  notifSeguimientosPendientes Boolean @default(true) @map("notif_seguimientos_pendientes")
  notifPacientesInactivos     Boolean @default(false) @map("notif_pacientes_inactivos")

  // Recordatorios para el paciente
  notifPlanDelDia         Boolean @default(true) @map("notif_plan_del_dia")
  notifTurno24h           Boolean @default(true) @map("notif_turno_24h")
  notifTurno2h            Boolean @default(true) @map("notif_turno_2h")
  notifTipsRecetas        Boolean @default(false) @map("notif_tips_recetas")
  notifSeguimientoSemanal Boolean @default(true) @map("notif_seguimiento_semanal")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String
  recipient String   @db.Text
  message   String   @db.Text
  status    String   @default("SENT")
  error     String?  @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")

  @@index([userId, type, sentAt])
  @@map("notification_logs")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}
