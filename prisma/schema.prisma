generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// AUTH INFRASTRUCTURE
// ──────────────────────────────────────────────

model User {
  id        String      @id @default(uuid()) @db.Uuid
  email     String      @unique
  password  String
  fullName  String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  firstName String?
  lastName  String?
  username  String?     @unique
  userRoles UserRole[]

  // WhatsApp settings
  whatsappSetting          WhatsAppSetting?

  // Patient portal
  patient                  Patient?

  // Nutrition relations
  professionalAppointments Appointment[]       @relation("ProfessionalAppointments")
  professionalAvailability Availability[]
  uploadedPatientFiles     PatientFile[]       @relation("UploadedPatientFiles")
  uploadedProgressPhotos   ProgressPhoto[]     @relation("UploadedProgressPhotos")
  measurementsTaken        AnthropometricMeasurement[] @relation("MeasurementsTaken")
  createdPlans             NutritionPlan[]     @relation("CreatedPlans")
  createdRecipes           Recipe[]            @relation("CreatedRecipes")

  // Legacy inventory relations (to be removed in Phase 24)
  deliveries          Delivery[]
  deliveredDeliveries Delivery[]          @relation("DeliveryDeliveredBy")
  purchaseOrders      PurchaseOrder[]
  stockMovements      StockMovement[]
  warehouseTransfers  WarehouseTransfer[]
  loansCreated        Loan[]              @relation("LoanCreatedBy")

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  action      String           @unique
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ──────────────────────────────────────────────
// PATIENTS
// ──────────────────────────────────────────────

model Patient {
  id               String                  @id @default(uuid()) @db.Uuid
  userId           String?                 @unique @db.Uuid
  firstName        String
  lastName         String
  email            String?
  phone            String?
  birthDate        DateTime?
  documentNumber   String?
  address          String?
  city             String?
  occupation       String?
  emergencyContact String?
  emergencyPhone   String?
  healthInsurance  String?
  billingType      String
  status           String                  @default("ACTIVE")
  notes            String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  deletedAt        DateTime?

  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments               Appointment[]
  medicalHistory            MedicalHistory?
  allergies                 Allergy[]
  medications               Medication[]
  goals                     PatientGoal[]
  measurements              AnthropometricMeasurement[]
  progressPhotos            ProgressPhoto[]
  nutritionPlans            NutritionPlanPatient[]
  followUps                 FollowUp[]
  files                     PatientFile[]
  consents                  Consent[]
  payments                  Payment[]
  waitlistEntries           WaitlistEntry[]
  messageThreads            MessageThread[]

  @@map("patients")
}

// ──────────────────────────────────────────────
// MEDICAL HISTORY
// ──────────────────────────────────────────────

model MedicalHistory {
  id                String   @id @default(uuid()) @db.Uuid
  patientId         String   @unique @db.Uuid
  familyHistory     String?
  personalHistory   String?
  surgeries         String?
  diagnoses         String?
  habits            String?
  sleepHours        String?
  physicalActivity  String?
  digestiveSymptoms String?
  observations      String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medical_histories")
}

model Allergy {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  name      String
  reaction  String?
  severity  String?
  notes     String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("allergies")
}

model Medication {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  name        String
  dosage      String?
  frequency   String?
  indication  String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("medications")
}

model PatientGoal {
  id          String    @id @default(uuid()) @db.Uuid
  patientId   String    @db.Uuid
  type        String
  description String?
  targetValue String?
  targetDate  DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_goals")
}

// ──────────────────────────────────────────────
// APPOINTMENTS & AVAILABILITY
// ──────────────────────────────────────────────

model Appointment {
  id                String            @id @default(uuid()) @db.Uuid
  patientId         String            @db.Uuid
  professionalId    String            @db.Uuid
  type              AppointmentType
  status            AppointmentStatus @default(PENDING)
  startAt           DateTime
  endAt             DateTime
  location          String?
  meetingUrl        String?
  notes             String?
  cancellationReason String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  patient      Patient @relation(fields: [patientId], references: [id])
  professional User    @relation("ProfessionalAppointments", fields: [professionalId], references: [id])

  @@map("appointments")
}

model Availability {
  id            String   @id @default(uuid()) @db.Uuid
  professionalId String  @db.Uuid
  weekday       Int
  startTime     String
  endTime       String
  slotDuration  Int      @default(30)
  isActive      Boolean  @default(true)

  professional User @relation(fields: [professionalId], references: [id])

  @@map("availability")
}

// ──────────────────────────────────────────────
// MEASUREMENTS & PROGRESS
// ──────────────────────────────────────────────

model AnthropometricMeasurement {
  id                 String   @id @default(uuid()) @db.Uuid
  patientId          String   @db.Uuid
  appointmentId      String?
  measuredById       String?  @db.Uuid
  measuredAt         DateTime @default(now())
  weight             Decimal? @db.Decimal(5, 2)
  height             Decimal? @db.Decimal(5, 2)
  bmi                Decimal? @db.Decimal(4, 2)
  waist              Decimal? @db.Decimal(5, 2)
  hip                Decimal? @db.Decimal(5, 2)
  arm                Decimal? @db.Decimal(5, 2)
  bodyFatPercentage  Decimal? @db.Decimal(4, 2)
  muscleMass         Decimal? @db.Decimal(5, 2)
  notes              String?

  patient     Patient @relation(fields: [patientId], references: [id])
  measuredBy  User?   @relation("MeasurementsTaken", fields: [measuredById], references: [id])

  @@map("anthropometric_measurements")
}

model ProgressPhoto {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  uploadedById    String?  @db.Uuid
  url             String
  publicId        String
  type            String
  takenAt         DateTime?
  consentGranted  Boolean  @default(false)
  createdAt       DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User?   @relation("UploadedProgressPhotos", fields: [uploadedById], references: [id])

  @@map("progress_photos")
}

// ──────────────────────────────────────────────
// NUTRITION PLANS
// ──────────────────────────────────────────────

model NutritionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  professionalId  String   @db.Uuid
  title           String
  description     String?
  startDate       DateTime?
  endDate         DateTime?
  status          String   @default("DRAFT")
  calorieTarget   Int?
  proteinTarget   Int?
  carbTarget      Int?
  fatTarget       Int?
  notes           String?
  tips            String?
  pdfUrl          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  professional User                 @relation("CreatedPlans", fields: [professionalId], references: [id])
  patients     NutritionPlanPatient[]
  days         NutritionPlanDay[]
  recipes      Recipe[]
  supplements  PlanSupplement[]

  @@map("nutrition_plans")
}

model NutritionPlanPatient {
  planId     String   @db.Uuid
  patientId  String   @db.Uuid
  assignedAt DateTime @default(now())

  plan    NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  patient Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([planId, patientId])
  @@map("nutrition_plan_patients")
}

model NutritionPlanDay {
  id       String @id @default(uuid()) @db.Uuid
  planId   String @db.Uuid
  dayOrder Int
  label    String

  plan  NutritionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  meals Meal[]

  @@map("nutrition_plan_days")
}

model Meal {
  id        String @id @default(uuid()) @db.Uuid
  dayId     String @db.Uuid
  label     String
  mealOrder Int
  notes     String?

  day   NutritionPlanDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  foods MealFood[]

  @@map("meals")
}

model MealFood {
  id       String   @id @default(uuid()) @db.Uuid
  mealId   String   @db.Uuid
  name     String
  quantity String?
  unit     String?
  notes    String?
  calories Int?
  protein  Decimal? @db.Decimal(5, 2)
  carbs    Decimal? @db.Decimal(5, 2)
  fat      Decimal? @db.Decimal(5, 2)

  meal Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@map("meal_foods")
}

model PlanSupplement {
  id               String  @id @default(uuid()) @db.Uuid
  nutritionPlanId  String  @db.Uuid
  name             String
  dosage           String?
  timing           String?
  frequency        String?
  notes            String?

  nutritionPlan NutritionPlan @relation(fields: [nutritionPlanId], references: [id], onDelete: Cascade)

  @@map("plan_supplements")
}

// ──────────────────────────────────────────────
// RECIPES & SHOPPING LISTS
// ──────────────────────────────────────────────

model Recipe {
  id            String   @id @default(uuid()) @db.Uuid
  professionalId String  @db.Uuid
  nutritionPlanId String? @db.Uuid
  title         String
  description   String?
  ingredients   String?
  instructions  String?
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  professional User          @relation("CreatedRecipes", fields: [professionalId], references: [id])
  nutritionPlan NutritionPlan? @relation(fields: [nutritionPlanId], references: [id], onDelete: SetNull)

  @@map("recipes")
}

model ShoppingList {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String?
  nutritionPlanId String?
  title           String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items ShoppingListItem[]

  @@map("shopping_lists")
}

model ShoppingListItem {
  id          String  @id @default(uuid()) @db.Uuid
  listId      String  @db.Uuid
  name        String
  quantity    String?
  unit        String?
  isChecked   Boolean @default(false)

  list ShoppingList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@map("shopping_list_items")
}

// ──────────────────────────────────────────────
// FOLLOW-UPS
// ──────────────────────────────────────────────

model FollowUp {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  weekStart   DateTime
  weight      Decimal? @db.Decimal(5, 2)
  adherence   String?
  hunger      String?
  energy      String?
  difficulties String?
  patientNotes String?
  proNotes    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("follow_ups")
}

// ──────────────────────────────────────────────
// FILES & CONSENTS
// ──────────────────────────────────────────────

model PatientFile {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  uploadedById String? @db.Uuid
  name        String
  url         String
  publicId    String?
  mimeType    String?
  size        Int?
  category    String?
  createdAt   DateTime @default(now())

  patient    Patient @relation(fields: [patientId], references: [id])
  uploadedBy User?   @relation("UploadedPatientFiles", fields: [uploadedById], references: [id])

  @@map("patient_files")
}

model Consent {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  type        String
  version     String?
  signedAt    DateTime @default(now())
  signature   String?
  ipAddress   String?
  documentUrl String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("consents")
}

// ──────────────────────────────────────────────
// FINANCES
// ──────────────────────────────────────────────

model Payment {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  amount      Decimal  @db.Decimal(10, 2)
  method      String
  description String?
  date        DateTime @default(now())
  notes       String?

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("payments")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  category    String
  description String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @default(now())
  notes       String?

  @@map("expenses")
}

// ──────────────────────────────────────────────
// WAITLIST & MESSAGES
// ──────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])

  @@map("waitlist_entries")
}

model MessageThread {
  id        String   @id @default(uuid()) @db.Uuid
  patientId String   @db.Uuid
  createdAt DateTime @default(now())

  patient  Patient     @relation(fields: [patientId], references: [id])
  messages Message[]

  @@map("message_threads")
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  threadId  String   @db.Uuid
  authorId  String   @db.Uuid
  content   String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("messages")
}

// ──────────────────────────────────────────────
// WHATSAPP & NOTIFICATIONS
// ──────────────────────────────────────────────

model WhatsAppSetting {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  encryptedPhone  String   @map("encrypted_phone") @db.Text
  encryptedApiKey String   @map("encrypted_api_key") @db.Text
  enabled         Boolean  @default(true)

  // Recordatorios para el profesional
  notifTurnosHoy              Boolean @default(true) @map("notif_turnos_hoy")
  notifTurnosManana           Boolean @default(true) @map("notif_turnos_manana")
  notifSeguimientosPendientes Boolean @default(true) @map("notif_seguimientos_pendientes")
  notifPacientesInactivos     Boolean @default(false) @map("notif_pacientes_inactivos")

  // Recordatorios para el paciente
  notifPlanDelDia             Boolean @default(true) @map("notif_plan_del_dia")
  notifTurno24h               Boolean @default(true) @map("notif_turno_24h")
  notifTurno2h                Boolean @default(true) @map("notif_turno_2h")
  notifTipsRecetas            Boolean @default(false) @map("notif_tips_recetas")
  notifSeguimientoSemanal     Boolean @default(true) @map("notif_seguimiento_semanal")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("whatsapp_settings")
}

model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  recipient String   @db.Text
  message   String   @db.Text
  status    String   @default("SENT")
  error     String?  @db.Text
  sentAt    DateTime @default(now()) @map("sent_at")

  @@index([userId, type, sentAt])
  @@map("notification_logs")
}

// ──────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────

enum AppointmentType {
  ONLINE
  IN_PERSON
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

// ──────────────────────────────────────────────
// LEGACY MODELS (to be removed in Phase 24)
// ──────────────────────────────────────────────

model Warehouse {
  id               String              @id @default(uuid()) @db.Uuid
  name             String              @unique
  code             String              @unique
  description      String?
  address          String?
  type             WarehouseType       @default(DEPOSIT)
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  deletedAt        DateTime?
  deliveries       Delivery[]
  purchaseOrders   PurchaseOrder[]
  purchaseReceipts PurchaseReceipt[]
  stockMovements   StockMovement[]
  stockItems       WarehouseStock[]
  transfersFrom    WarehouseTransfer[] @relation("TransferFrom")
  transfersTo      WarehouseTransfer[] @relation("TransferTo")
  loans            Loan[]

  @@map("warehouses")
}

model WarehouseStock {
  id          String    @id @default(uuid()) @db.Uuid
  warehouseId String    @db.Uuid
  productId   String    @db.Uuid
  quantity    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId])
  @@map("warehouse_stock")
}

model WarehouseTransfer {
  id              String         @id @default(uuid()) @db.Uuid
  fromWarehouseId String         @db.Uuid
  toWarehouseId   String         @db.Uuid
  productId       String         @db.Uuid
  quantity        Int
  status          TransferStatus @default(PENDING)
  notes           String?
  userId          String         @db.Uuid
  createdAt       DateTime       @default(now())
  completedAt     DateTime?
  deletedAt       DateTime?
  expedienteId    String?        @db.Uuid
  expediente      Expediente?    @relation(fields: [expedienteId], references: [id])
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  product         Product        @relation(fields: [productId], references: [id])
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  user            User           @relation(fields: [userId], references: [id])

  @@map("warehouse_transfers")
}

model Supplier {
  id             String                @id @default(uuid()) @db.Uuid
  name           String
  code           String                @unique
  email          String?
  phone          String?
  address        String?
  contactName    String?
  notes          String?
  isActive       Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  deletedAt      DateTime?
  priceHistories ProductPriceHistory[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  receipts       PurchaseReceipt[]

  @@map("suppliers")
}

model PurchaseOrder {
  id            String              @id @default(uuid()) @db.Uuid
  orderNumber   String              @unique
  supplierId    String              @db.Uuid
  warehouseId   String              @db.Uuid
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  receivedDate  DateTime?
  notes         String?
  subject       String              @default("")
  causative     String              @default("")
  responsible   String              @default("")
  totalAmount   Decimal             @db.Decimal(10, 2)
  createdById   String              @db.Uuid
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  expedienteId  String?             @db.Uuid
  invoiceUrl    String?
  creditNoteUrl String?
  debitNoteUrl  String?
  items         PurchaseOrderItem[]
  createdBy     User                @relation(fields: [createdById], references: [id])
  expediente    Expediente?         @relation(fields: [expedienteId], references: [id])
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId], references: [id])
  receipts      PurchaseReceipt[]

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String                @id @default(uuid()) @db.Uuid
  purchaseOrderId String                @db.Uuid
  productId       String                @db.Uuid
  quantity        Int
  receivedQty     Int                   @default(0)
  unitPrice       Decimal               @db.Decimal(10, 2)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  product         Product               @relation(fields: [productId], references: [id])
  purchaseOrder   PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  receiptItems    PurchaseReceiptItem[]

  @@map("purchase_order_items")
}

model Institution {
  id          String     @id @default(uuid()) @db.Uuid
  name        String
  code        String     @unique
  type        String?
  contactName String?
  email       String?
  phone       String?
  address     String?
  notes       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  deliveries  Delivery[]

  @@map("institutions")
}

model Delivery {
  id                   String         @id @default(uuid()) @db.Uuid
  deliveryNumber       String         @unique
  institutionId        String         @db.Uuid
  warehouseId          String         @db.Uuid
  status               DeliveryStatus @default(DRAFT)
  deliveryDate         DateTime?
  receivedBy           String?
  notes                String?
  createdById          String         @db.Uuid
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?
  expedienteId         String?        @db.Uuid
  deliveryProofUrl     String?
  deliveredById        String?        @db.Uuid
  disaffectionReviewed Boolean        @default(false)
  createdBy            User           @relation(fields: [createdById], references: [id])
  deliveredBy          User?          @relation("DeliveryDeliveredBy", fields: [deliveredById], references: [id])
  expediente           Expediente?    @relation(fields: [expedienteId], references: [id])
  institution          Institution    @relation(fields: [institutionId], references: [id])
  warehouse            Warehouse      @relation(fields: [warehouseId], references: [id])
  items                DeliveryItem[]

  @@map("deliveries")
}

model DeliveryItem {
  id                  String   @id @default(uuid()) @db.Uuid
  deliveryId          String   @db.Uuid
  productId           String   @db.Uuid
  quantity            Int
  disaffectedQuantity Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  delivery            Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id])

  @@map("delivery_items")
}

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  products    Product[]

  @@map("categories")
}

model Product {
  id                 String                @id @default(uuid()) @db.Uuid
  sku                String                @unique
  name               String
  brand              String?
  description        String?
  price              Decimal               @db.Decimal(10, 2)
  minStock           Int                   @default(0)
  categoryId         String?               @db.Uuid
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  supplierId         String?               @db.Uuid
  unit               String                @default("U")
  deletedAt          DateTime?
  deliveryItems      DeliveryItem[]
  priceHistories     ProductPriceHistory[]
  category           Category?             @relation(fields: [categoryId], references: [id])
  supplier           Supplier?             @relation(fields: [supplierId], references: [id])
  purchaseOrderItems PurchaseOrderItem[]
  receiptItems       PurchaseReceiptItem[]
  movements          StockMovement[]
  warehouseStock     WarehouseStock[]
  warehouseTransfers WarehouseTransfer[]
  loanItems          LoanItem[]

  @@map("products")
}

model StockMovement {
  id           String       @id @default(uuid()) @db.Uuid
  productId    String       @db.Uuid
  type         MovementType
  quantity     Int
  reason       String?
  userId       String       @db.Uuid
  createdAt    DateTime     @default(now())
  warehouseId  String?      @db.Uuid
  expedienteId String?      @db.Uuid
  sourceId     String       @db.Uuid
  sourceType   String
  deletedAt    DateTime?
  loanId       String?      @db.Uuid
  expediente   Expediente?  @relation(fields: [expedienteId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  warehouse    Warehouse?   @relation(fields: [warehouseId], references: [id])
  loan         Loan?        @relation(fields: [loanId], references: [id])

  @@map("stock_movements")
}

model ExpedienteCategory {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  expedientes Expediente[]

  @@map("expediente_categories")
}

model Expediente {
  id          String              @id @default(uuid()) @db.Uuid
  number      String              @unique
  description String?
  status      String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  origin      String?
  type        String?
  categoryId  String?             @db.Uuid
  category    ExpedienteCategory? @relation(fields: [categoryId], references: [id])
  year        Int?
  deletedAt   DateTime?
  deliveries  Delivery[]
  purchases   PurchaseOrder[]
  receipts    PurchaseReceipt[]
  movements   StockMovement[]
  transfers   WarehouseTransfer[]
  loans       Loan[]

  @@map("expedientes")
}

model PurchaseReceipt {
  id              String                @id @default(uuid()) @db.Uuid
  purchaseOrderId String?               @db.Uuid
  receiptNumber   String
  date            DateTime
  totalAmount     Decimal               @db.Decimal(10, 2)
  status          PurchaseReceiptStatus @default(ACTIVE)
  imageUrl        String?
  expedienteId    String?               @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  type            String                @default("PURCHASE")
  deletedAt       DateTime?
  warehouseId     String?               @db.Uuid
  supplierId      String?               @db.Uuid
  items           PurchaseReceiptItem[]
  expediente      Expediente?           @relation(fields: [expedienteId], references: [id])
  purchaseOrder   PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  supplier        Supplier?             @relation(fields: [supplierId], references: [id])
  warehouse       Warehouse?            @relation(fields: [warehouseId], references: [id])

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id                  String               @id @default(uuid()) @db.Uuid
  receiptId           String               @db.Uuid
  purchaseOrderItemId String?              @db.Uuid
  productId           String               @db.Uuid
  quantity            Int
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  unitPrice           Decimal              @default(0) @db.Decimal(10, 2)
  priceHistory        ProductPriceHistory?
  product             Product              @relation(fields: [productId], references: [id])
  purchaseOrderItem   PurchaseOrderItem?   @relation(fields: [purchaseOrderItemId], references: [id])
  receipt             PurchaseReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, purchaseOrderItemId])
  @@map("purchase_receipt_items")
}

model Loan {
  id              String          @id @default(uuid()) @db.Uuid
  number          String          @unique
  warehouseId     String          @db.Uuid
  responsibleName String
  responsibleDni  String
  destination     String
  notes           String?
  proofUrl        String
  status          LoanStatus      @default(ACTIVE)
  createdById     String          @db.Uuid
  expedienteId    String?         @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy       User            @relation("LoanCreatedBy", fields: [createdById], references: [id])
  expediente      Expediente?     @relation(fields: [expedienteId], references: [id])
  items           LoanItem[]
  movements       StockMovement[]

  @@map("loans")
}

model LoanItem {
  id        String   @id @default(uuid()) @db.Uuid
  loanId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([loanId, productId])
  @@map("loan_items")
}

model ProductPriceHistory {
  id            String              @id @default(uuid()) @db.Uuid
  productId     String              @db.Uuid
  receiptItemId String              @unique @db.Uuid
  supplierId    String?             @db.Uuid
  unitPrice     Decimal             @db.Decimal(10, 2)
  quantity      Int
  receiptDate   DateTime
  createdAt     DateTime            @default(now())
  product       Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  receiptItem   PurchaseReceiptItem @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)
  supplier      Supplier?           @relation(fields: [supplierId], references: [id])

  @@map("product_price_history")
}

// ──────────────────────────────────────────────
// LEGACY ENUMS
// ──────────────────────────────────────────────

enum TransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum WarehouseType {
  DEPOSIT
  OFFICE
}

enum PurchaseOrderStatus {
  DRAFT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum DeliveryStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  CANCELLED
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

enum LoanStatus {
  ACTIVE
  CANCELLED
}

enum PurchaseReceiptStatus {
  ACTIVE
  COMPLETED
}
